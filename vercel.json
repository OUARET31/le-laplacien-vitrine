{
  "rewrites": [ { "source": "/stats", "destination": "/api/stats" } ],
  "headers": [
    { "source": "/contenu/(.*)", "headers": [ { "key": "Cache-Control", "value": "private, no-store" } ] },
    { "source": "/media/(.*)", "headers": [ { "key": "Access-Control-Allow-Origin", "value": "*" } ] }
  ]
}
